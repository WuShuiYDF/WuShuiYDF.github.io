---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const { title, date, tags, category, summary } = post.data;
const dateStr = date.toLocaleDateString('zh-CN', { year: 'numeric', month: '2-digit', day: '2-digit' });
const excerpt = summary ?? '';
---

<a href={`/posts/${post.id}/`} class="reveal glass noise group block p-6 transition-transform duration-300 hover:-translate-y-1">
  <h3 class="text-lg font-bold transition-colors group-hover:text-[var(--color-primary)]">
    {title}
  </h3>
  <p class="mt-2 text-xs text-[var(--color-muted)]">
    <time datetime={date.toISOString()}>{dateStr}</time>
    {category && <span class="ml-2 rounded-full bg-[color-mix(in_oklab,var(--color-accent)_18%,transparent)] px-2 py-0.5">{category}</span>}
  </p>
  {excerpt && <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-[var(--color-muted)]">{excerpt.slice(0, 80)}{excerpt.length > 80 ? '…' : ''}</p>}
  {
    tags.length > 0 && (
      <p class="mt-3 flex flex-wrap gap-1.5">
        {tags.map((t) => (
          <span class="text-xs text-[var(--color-muted)]">#{t}</span>
        ))}
      </p>
    )
  }
</a>
