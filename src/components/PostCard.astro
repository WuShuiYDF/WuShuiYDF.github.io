---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const { title, date, tags, summary } = post.data;
const dateStr = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
const minutes = Math.max(1, Math.round((post.body?.length ?? 0) / 450));
const excerpt = summary ?? '';
---

<a href={`/posts/${post.id}/`} class="group block h-full">
  <article
    class:list={[
      'relative flex h-full flex-col overflow-hidden rounded-xl border bg-[var(--color-surface)] px-6 transition-all duration-300',
      featured ? 'py-8' : 'py-5 hover:-translate-y-0.5',
      'border-[color-mix(in_oklab,var(--color-primary)_28%,transparent)]',
      !featured && 'border-white/[0.07] hover:border-[color-mix(in_oklab,var(--color-primary)_45%,transparent)]',
    ]}
  >
    <span
      aria-hidden
      class="pointer-events-none absolute inset-x-0 top-0 h-px origin-left scale-x-0 bg-[var(--color-primary)] transition-transform duration-500 group-hover:scale-x-100"
    >
    </span>
    <header class="flex items-baseline gap-3">
      <span
        class:list={[
          'mono-date tracking-[0.08em]',
          featured ? 'text-[var(--color-primary)]' : 'text-[var(--color-muted)]',
        ]}
      >
        {dateStr}
      </span>
      {
        featured && (
          <span class="rounded-full border border-[color-mix(in_oklab,var(--color-primary)_50%,transparent)] px-2 py-0.5 font-mono text-[0.62rem] text-[var(--color-primary)]">
            featured
          </span>
        )
      }
    </header>
    <h3
      class:list={[
        'mt-2 font-bold leading-snug tracking-tight transition-colors group-hover:text-[var(--color-primary)]',
        featured ? 'text-[clamp(1.5rem,4vw,2.1rem)]' : 'line-clamp-2 text-[1.12rem]',
      ]}
    >
      {title}
    </h3>
    {
      excerpt && (
        <p
          class:list={[
            'mt-2 text-[var(--color-muted)]',
            featured ? 'line-clamp-3 text-[1rem] leading-relaxed' : 'line-clamp-2 text-[0.88rem] leading-relaxed',
          ]}
        >
          {excerpt}
        </p>
      )
    }
    <footer class="mt-auto flex flex-wrap items-center gap-2 pt-4">
      {
        tags.slice(0, 4).map((t) => (
          <span class="font-mono text-[0.68rem] tracking-wide text-[var(--color-muted)] transition-colors group-hover:text-[color-mix(in_oklab,var(--color-primary)_80%,transparent)]">
            #{t}
          </span>
        ))
      }
      <span class="ms-auto font-mono text-[0.68rem] text-[var(--color-muted)]">{minutes} min</span>
    </footer>
  </article>
</a>
