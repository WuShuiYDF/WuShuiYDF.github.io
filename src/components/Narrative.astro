---
// 宣言段：编号台账式排版（01-05 + hairline 分隔 + 关键词冷锚色），滚动错落揭示，无 pin
const lines = [
  { text: '内容即 git', accent: 'git' },
  { text: '动效有纪律', accent: '' },
  { text: '暗色从第一天', accent: '' },
  { text: '写作一键发布', accent: '一键发布' },
  { text: 'AI 就地回答', accent: 'AI' },
];
---

<section class="narr mx-auto max-w-5xl px-5 py-28" aria-label="宣言">
  <p class="kicker">Manifesto</p>
  <div class="mt-8 border-t border-white/[0.07]">
    {
      lines.map((line, i) => (
        <div class="reveal group flex items-baseline gap-6 border-b border-white/[0.07] py-6 md:gap-10 md:py-8">
          <span class="mono-date shrink-0 text-[var(--color-muted)] transition-colors group-hover:text-[var(--color-primary)]">
            {String(i + 1).padStart(2, '0')}
          </span>
          <p class="text-[clamp(1.5rem,4.5vw,2.6rem)] font-bold leading-tight tracking-tight text-[var(--color-ink)] transition-colors">
            {line.accent ? (
              <>
                {line.text.split(line.accent)[0]}
                <span class="text-[var(--color-primary)]">{line.accent}</span>
                {line.text.split(line.accent)[1] ?? ''}
              </>
            ) : (
              line.text
            )}
          </p>
          <span
            aria-hidden
            class="pointer-events-none ms-auto hidden h-px flex-1 origin-right scale-x-0 bg-[color-mix(in_oklab,var(--color-primary)_50%,transparent)] transition-transform duration-700 group-hover:origin-left group-hover:scale-x-100 md:block"
          />
        </div>
      ))
    }
  </div>
</section>
