<button
  id="theme-toggle"
  class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-[var(--color-ink)] transition-transform hover:scale-105"
  aria-label="切换深浅主题"
>
  <svg class="theme-icon-dark h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <path
      d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
  <svg class="theme-icon-light hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <circle cx="12" cy="12" r="4" />
    <path
      d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
      stroke-linecap="round"
    />
  </svg>
</button>

<script>
  function syncIcons() {
    const dark = document.documentElement.dataset.theme !== 'light';
    document.querySelector('.theme-icon-dark')?.classList.toggle('hidden', !dark);
    document.querySelector('.theme-icon-light')?.classList.toggle('hidden', dark);
  }
  // 事件委托：View Transitions 换页后按钮是新 DOM，委托到 document 才不丢
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;
    if (!e.target.closest('#theme-toggle')) return;
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('wsydf-theme', next);
    syncIcons();
  });
  document.addEventListener('astro:after-swap', syncIcons);
  syncIcons();
</script>
