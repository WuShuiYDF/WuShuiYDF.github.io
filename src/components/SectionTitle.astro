---
interface Props {
  title: string;
  sub?: string;
}
const { title, sub } = Astro.props;
---

<h2 class="text-2xl font-bold md:text-3xl" style="font-family: var(--font-display)">
  <span class="glow-text">{title}</span>
  {sub && <span class="ml-3 text-sm font-normal text-[var(--color-muted)]">{sub}</span>}
</h2>
