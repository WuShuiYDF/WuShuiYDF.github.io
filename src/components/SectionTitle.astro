---
interface Props {
  title: string;
  sub?: string;
  kicker?: string;
}
const { title, sub, kicker } = Astro.props;
---

<div>
  {kicker && <p class="kicker">{kicker}</p>}
  <h2 class="mt-2 text-2xl font-bold md:text-3xl">
    <span class="glow-text">{title}</span>
    {sub && <span class="ml-3 text-sm font-normal text-[var(--color-muted)]">{sub}</span>}
  </h2>
</div>
