---
import { SITE } from '../config';

const social = [
  { name: 'GitHub', href: SITE.github },
  { name: '一凡AI', href: SITE.coze },
  { name: '官方网站', href: 'http://www.wushuiydf.com' },
];
---

<footer class="mt-24 border-t border-white/[0.07]">
  <div class="mx-auto grid max-w-5xl gap-10 px-5 py-14 sm:grid-cols-2">
    <div>
      <p class="text-[1.02rem] font-bold tracking-tight text-[var(--color-ink)]">{SITE.subtitle}</p>
      <p class="mt-2 max-w-xs text-[0.92rem] leading-relaxed text-[var(--color-muted)]">
        {SITE.name} · {SITE.description}
      </p>
    </div>
    <div class="sm:justify-self-end">
      <div class="flex flex-col gap-2">
        {
          social.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex w-fit items-center gap-2 text-[0.9rem] text-[var(--color-muted)] transition-colors hover:text-[var(--color-primary)]"
            >
              {s.name}
              <svg class="h-3 w-3 opacity-50 transition-opacity group-hover:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          ))
        }
        <a href="/admin/" class="inline-flex w-fit items-center gap-2 text-[0.9rem] text-[var(--color-muted)] transition-colors hover:text-[var(--color-primary)]">后台管理</a>
      </div>
    </div>
  </div>
  <div class="border-t border-white/[0.07]">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-2 px-5 py-4 font-mono text-[0.7rem] text-[var(--color-muted)]">
      <span>© {new Date().getFullYear()} {SITE.name} · wushuiydf.com</span>
      <span>Markdown 即内容 · 由 AI 协作构建</span>
    </div>
  </div>
</footer>
