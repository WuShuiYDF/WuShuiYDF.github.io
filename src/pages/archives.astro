---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
---

<BaseLayout title="归档">
  <div class="py-12">
    <SectionTitle title="归档" sub={`共 ${posts.length} 篇`} />

    {
      years.map((year) => (
        <section class="mt-10">
          <h3 class="text-2xl font-bold">
            <span class="glow-text">{year}</span>
          </h3>
          <ul class="mt-4 ml-1 space-y-1 border-l border-white/10">
            {byYear.get(year)!.map((post) => (
              <li class="reveal group flex items-baseline gap-4 py-1.5 pl-5">
                <time
                  datetime={post.data.date.toISOString()}
                  class="shrink-0 font-mono text-xs text-[var(--color-muted)]"
                >
                  {fmt(post.data.date)}
                </time>
                <a
                  href={`/posts/${post.id}/`}
                  class="text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-primary)]"
                >
                  {post.data.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</BaseLayout>
