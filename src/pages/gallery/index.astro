---
import BaseLayout from '../../layouts/BaseLayout.astro';
import galleryJson from '../../data/gallery.json';

interface GalleryGroup {
  key: string;
  title: string;
  description?: string;
  cover?: string;
  images: { alt?: string; url: string }[];
}
const groups = (galleryJson as GalleryGroup[]).filter((g) => g.images.length > 0);
---

<BaseLayout title="相册" width="wide">
  <div class="py-12">
    <p class="kicker">Gallery</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-[var(--color-ink)]">
      相册 <span class="ml-3 text-sm font-normal text-[var(--color-muted)]">{groups.length} 个图集</span>
    </h1>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        groups.map((group) => (
          <a
            href={`/gallery/${group.key}/`}
            class="reveal group block overflow-hidden rounded-xl border border-white/[0.08] bg-[var(--color-surface)] transition-all duration-300 hover:-translate-y-1 hover:border-[color-mix(in_oklab,var(--color-primary)_50%,transparent)]"
          >
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={group.cover ?? group.images[0]?.url}
                alt={group.title}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              />
              <span class="absolute bottom-3 right-3 rounded-full bg-black/55 px-2.5 py-1 font-mono text-[0.68rem] text-white/90 backdrop-blur-sm">
                {group.images.length} 张
              </span>
            </div>
            <div class="p-5">
              <h2 class="font-bold text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-primary)]">{group.title}</h2>
              {group.description && (
                <p class="mt-1 line-clamp-1 text-sm text-[var(--color-muted)]">{group.description}</p>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
