---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Narrative from '../components/Narrative.astro';
import WorldHero from '../components/WorldHero.astro';
import { NAV } from '../config';
import linksJson from '../data/links.json';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const tagCounts = new Map<string, number>();
for (const p of posts) for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 14);

const linkCount = (linksJson as { link_list: unknown[] }[]).reduce(
  (n, g) => n + g.link_list.length,
  0,
);
const stat = `${posts.length} 篇 · ${tags.length} 分类 · ${linkCount} 链接`;

const [featured, ...rest] = posts.slice(0, 5);
---

<BaseLayout width="wide">
  <!-- Hero：左对齐满屏，双行标题遮罩揭示（照上一版 HeroFront） -->
  <section class="relative flex min-h-[100dvh] flex-col justify-center overflow-hidden pb-10 pt-16">
    <div aria-hidden class="disk-grid pointer-events-none absolute inset-0"></div>
    <WorldHero />
    <div aria-hidden class="pointer-events-none absolute inset-0 overflow-hidden">
      <span class="orbit-ring right-[-10%] top-[12%] h-[420px] w-[420px]"></span>
      <span class="orbit-ring right-[2%] top-[26%] h-[260px] w-[260px]"></span>
      <span class="orbit-ring right-[-2%] bottom-[8%] h-[560px] w-[560px]"></span>
      <span
        class="absolute right-[16%] top-[38%] h-2 w-2 rounded-full bg-[var(--color-primary)] opacity-70"
      ></span>
    </div>

    <div class="relative mx-auto w-full max-w-5xl px-5">
      <p class="kicker">Deep-Time Personal Blog</p>

      <h1 class="mt-8 text-[clamp(2.8rem,11vw,6.4rem)] font-bold leading-[1.02] tracking-[-0.03em]">
        <span class="block overflow-hidden pb-1">
          <span class="hero-line block will-change-transform" style="animation-delay: .1s">无水有点烦的</span>
        </span>
        <span class="block overflow-hidden pb-1">
          <span class="hero-line block will-change-transform" style="animation-delay: .23s">博客</span>
        </span>
      </h1>

      <div class="mt-8 flex max-w-xl flex-col gap-3">
        <p class="text-[1.05rem] leading-relaxed text-[var(--color-muted)]">
          把运筹、经济学、代码与生活的日常，写成能回滚的叙事。
        </p>
        <p class="font-mono text-[0.78rem] tracking-wide text-[var(--color-muted)]">{stat}</p>
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-5">
        <a
          href="#latest"
          class="group inline-flex items-center gap-2 rounded-full border border-[color-mix(in_oklab,var(--color-primary)_70%,transparent)] bg-[color-mix(in_oklab,var(--color-primary)_10%,transparent)] px-6 py-3 text-[0.95rem] font-semibold text-[var(--color-primary)] transition-colors hover:bg-[color-mix(in_oklab,var(--color-primary)_20%,transparent)]"
        >
          最新文章
          <svg class="h-4 w-4 transition-transform duration-300 group-hover:translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14m0 0-6-6m6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="/archives/" class="inline-flex items-center gap-1.5 text-[0.92rem] text-[var(--color-muted)] transition-colors hover:text-[var(--color-primary)]">
          全部归档
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- 最新文章：featured 大卡 + 两列错落 -->
  <section id="latest" class="mx-auto max-w-5xl scroll-mt-20 px-5">
    <h2 class="text-2xl font-bold tracking-tight text-[var(--color-ink)]">最新文章</h2>
    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      {featured && (
        <div class="reveal lg:col-span-2">
          <PostCard post={featured} featured />
        </div>
      )}
      {rest.map((p) => (
        <div class="reveal">
          <PostCard post={p} />
        </div>
      ))}
    </div>
  </section>

  <!-- 编辑体宣言（整段大字） -->
  <section class="mx-auto mt-28 max-w-3xl px-5 text-center">
    <p class="text-[clamp(1.6rem,5vw,2.6rem)] font-bold leading-snug tracking-tight text-[var(--color-ink)]">
      这里不赶工，只把沉下心研究的东西慢慢讲清。
    </p>
    <p class="mx-auto mt-6 max-w-md text-[0.95rem] leading-relaxed text-[var(--color-muted)]">
      从线性规划解炉石，到宏观经济学的拷打，每一篇都从一个真问题出发。
    </p>
  </section>

  <!-- GSAP pin 叙事段 -->
  <Narrative />

  <!-- 标签墙 -->
  <section class="mx-auto max-w-5xl px-5">
    <h2 class="text-2xl font-bold tracking-tight text-[var(--color-ink)]">标签墙</h2>
    <div class="mt-8 flex flex-wrap gap-2.5">
      {
        tags.map(([name, count]) => (
          <a
            href={`/tags/${name}/`}
            class="rounded-full border border-white/[0.08] px-3.5 py-1.5 font-mono text-[0.82rem] text-[var(--color-muted)] transition-all hover:-translate-y-0.5 hover:border-[color-mix(in_oklab,var(--color-primary)_60%,transparent)] hover:text-[var(--color-primary)]"
          >
            #{name}
            <span class="ml-1.5 text-[0.7em] opacity-70">{count}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 关于 + AI 两栏 -->
  <section class="mx-auto mt-28 grid max-w-5xl gap-6 px-5 lg:grid-cols-2">
    <div class="flex flex-col justify-between rounded-xl border border-white/[0.08] bg-[var(--color-surface)] p-8">
      <div>
        <h2 class="text-2xl font-bold tracking-tight text-[var(--color-ink)]">关于我</h2>
        <p class="mt-4 max-w-md leading-relaxed text-[var(--color-muted)]">
          西安交通大学管理学院在读。喜欢用数学和代码把生活中的决策讲清楚，也喜欢记录日常里那些值得留下的片刻。
        </p>
      </div>
      <a
        href="/about/"
        class="group mt-8 inline-flex w-fit items-center gap-2 text-[0.95rem] font-medium text-[var(--color-primary)]"
      >
        讲讲我自己
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>

    <div class="flex flex-col justify-between rounded-xl border border-[color-mix(in_oklab,var(--color-primary)_35%,transparent)] bg-[color-mix(in_oklab,var(--color-primary)_5%,transparent)] p-8">
      <div>
        <div class="flex items-center gap-2 font-mono text-[0.72rem] uppercase tracking-[0.2em] text-[var(--color-primary)]">
          AI
        </div>
        <h2 class="mt-4 text-2xl font-bold tracking-tight text-[var(--color-ink)]">一凡AI</h2>
        <p class="mt-4 leading-relaxed text-[var(--color-muted)]">
          我用 Coze 搭的 AI 小助手：日常问答、学习辅助和一些奇奇怪怪的小任务。实验性功能，内容由 AI 生成。
        </p>
      </div>
      <a
        href="/ai/"
        class="group mt-8 inline-flex w-fit items-center gap-2 text-[0.95rem] font-medium text-[var(--color-primary)]"
      >
        开始对话
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14m0 0-6-6m6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </section>

  <noscript>
    <nav class="mx-auto max-w-3xl px-5 pb-16 text-center">
      <p class="font-bold">站点导航</p>
      <p class="mt-3 flex flex-wrap justify-center gap-4">
        {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      </p>
      <p class="mt-6 font-bold">最新文章</p>
      <p class="mt-3 flex flex-col gap-2">
        {posts.map((p) => <a href={`/posts/${p.id}/`}>{p.data.title}</a>)}
      </p>
    </nav>
  </noscript>
</BaseLayout>

<style is:global>
  @keyframes hero-rise {
    from { transform: translateY(115%); }
    to { transform: translateY(0); }
  }
  .hero-line {
    animation: hero-rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-line { animation: none; }
  }
</style>
