---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import GlassCard from '../components/GlassCard.astro';
import { SITE } from '../config';
---

<BaseLayout title="一凡AI" description="基于 Coze 搭建的个人 AI 小助手：你的工作与学习小帮手">
  <div class="py-12 text-center">
    <SectionTitle title="一凡AI" sub="你的工作小助手" />
    <GlassCard class="mx-auto mt-10 max-w-xl text-left">
      <p class="leading-relaxed text-[var(--color-muted)]">
        我用 Coze 搭了一个 AI 小助手，擅长处理日常问答、学习辅助和一些奇奇怪怪的小任务。
        点击下方按钮即可开始对话（新标签页打开）。
      </p>
      <a
        href={SITE.coze}
        target="_blank"
        rel="noopener noreferrer"
        class="glow-ring mt-6 inline-block rounded-full bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)] px-8 py-3 font-bold text-white transition-transform hover:scale-105"
      >
        开始对话 →
      </a>
    </GlassCard>
  </div>
</BaseLayout>
