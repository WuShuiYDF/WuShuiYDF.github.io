---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import TOC from '../../components/TOC.astro';
import Giscus from '../../components/Giscus.astro';
import 'katex/dist/katex.min.css';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return posts.map((post, idx) => ({
    params: { id: post.id },
    props: { post, prev: posts[idx + 1], next: posts[idx - 1] },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const { title, date, tags, category, summary } = post.data;
const dateStr = `${date.getFullYear()}.${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`;
const minutes = Math.max(1, Math.round((post.body?.length ?? 0) / 450));
---

<BaseLayout title={title} description={summary}>
  <ReadingProgress />
  <div class="mx-auto flex max-w-5xl justify-center gap-10 px-5">
    <article class="w-full max-w-3xl py-12" transition:name={post.id}>
      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-2 font-mono text-[0.74rem] text-[var(--color-muted)]">
          <time class="mono-date" datetime={date.toISOString()}>{dateStr}</time>
          <span>/</span>
          <span>{minutes} 分钟阅读</span>
          {category && <span class="text-[var(--color-primary)]">#{category}</span>}
        </div>
        <h1 class="mt-4 text-[clamp(1.7rem,5vw,2.6rem)] font-bold leading-tight tracking-tight text-[var(--color-ink)]">
          {title}
        </h1>
        {
          summary && (
            <p class="mt-4 text-[1.02rem] leading-relaxed text-[var(--color-muted)]">{summary}</p>
          )
        }
      </header>

      <div class="prose">
        <Content />
      </div>

      <footer class="mt-14 border-t border-white/[0.07] pt-6">
        <div class="flex flex-wrap gap-2">
          {
            tags.map((t) => (
              <a
                href={`/tags/${t}/`}
                class="rounded-full border border-white/[0.08] px-3 py-1 font-mono text-[0.76rem] text-[var(--color-muted)] transition-colors hover:border-[color-mix(in_oklab,var(--color-primary)_60%,transparent)] hover:text-[var(--color-primary)]"
              >
                #{t}
              </a>
            ))
          }
        </div>

        <nav class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            prev ? (
              <a
                href={`/posts/${prev.id}/`}
                class="group rounded-lg border border-white/[0.08] p-4 transition-colors hover:border-[color-mix(in_oklab,var(--color-primary)_50%,transparent)]"
              >
                <span class="font-mono text-[0.68rem] text-[var(--color-muted)]">← 上一篇</span>
                <span class="mt-1 block text-[0.92rem] font-medium text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-primary)]">{prev.data.title}</span>
              </a>
            ) : (
              <span />
            )
          }
          {
            next && (
              <a
                href={`/posts/${next.id}/`}
                class="group rounded-lg border border-white/[0.08] p-4 text-right transition-colors hover:border-[color-mix(in_oklab,var(--color-primary)_50%,transparent)]"
              >
                <span class="font-mono text-[0.68rem] text-[var(--color-muted)]">下一篇 →</span>
                <span class="mt-1 block text-[0.92rem] font-medium text-[var(--color-ink)] transition-colors group-hover:text-[var(--color-primary)]">{next.data.title}</span>
              </a>
            )
          }
        </nav>
      </footer>

      <Giscus />
    </article>

    <aside class="sticky top-20 hidden h-fit w-56 shrink-0 py-12 xl:block">
      <TOC headings={headings} />
    </aside>
  </div>
</BaseLayout>
